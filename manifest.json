{
  "manifest_version": 3,
  "name": "Offline Workspace",
  "version": "2.0.2",
  "description": "An offline notes, calendar, and time-management workspace",
  "permissions": ["storage", "alarms", "notifications"],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "Open Offline Workspace",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
